{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": [
    "index.ts",
    "types/**/*.ts",
    "path/**/*.ts",
    "maps/**/*.ts",
    "maps/**/*.json",
    "towers/**/*.ts",
    "towers/**/*.json",
    "enemies/**/*.ts",
    "enemies/**/*.json",
    "waves/**/*.ts",
    "waves/**/*.json"
  ],
  "exclude": [
    "path/__tests__/**",
    ".test-dist/**"
  ]
}
